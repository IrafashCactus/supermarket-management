# ── App ──
APP_NAME=supermarket-pos
APP_ENV=development

# ── Backend ──
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=supermarket
DB_PASSWORD=supermarket_secret
DB_NAME=supermarket_db
DB_SSLMODE=disable
DATABASE_URL=postgres://supermarket:supermarket_secret@localhost:5432/supermarket_db?sslmode=disable

# ── JWT ──
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

